# Skopiuj ten plik jako .env i uzupełnij. Nie udostępniaj pliku .env (zawiera hasło).

# Hasło do edycji (oglądanie mapy nie wymaga logowania). Zmiana hasła wylogowuje wszystkich.
MAPA_HASLO=zmien-to-haslo

# Adres IP serwera w sieci lokalnej, na którym mapa ma być dostępna (np. 192.168.1.20).
# 0.0.0.0 = wszystkie karty sieciowe – w porządku, jeśli serwer nie ma publicznego adresu.
MAPA_ADRES=0.0.0.0

# Port, pod którym mapa będzie widoczna: http://<adres-serwera>:8000
MAPA_PORT_HOSTA=8000

# 1 = odrzucaj połączenia spoza sieci prywatnych (10.x, 172.16-31.x, 192.168.x). Zostaw 1.
MAPA_TYLKO_LAN=1

# Ile kopii zapasowych trzymać w dane/kopie (robione przed każdym wgraniem Excela).
MAPA_KOPIE=30
